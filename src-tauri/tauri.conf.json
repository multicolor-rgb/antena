{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antena",
  "version": "1.0.0",
  "identifier": "pl.antena.radio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antena · radio internetowe",
        "width": 440,
        "height": 680,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src * blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Lekkie radio internetowe",
    "longDescription": "Antena to bardzo lekkie radio internetowe: 200+ stacji, ulubione, wyszukiwanie, tytuł grającego utworu. Bez kont, bez reklam, bez chmury.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
